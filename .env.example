PORT=8000
SUPABASE_URL=
# La clave pública antigua solo permite consultas mientras se migra.
SUPABASE_KEY=
# Clave privada SOLO en el servidor; nunca en frontend ni en Git.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=garment-photos
SUPABASE_BACKUP_BUCKET=faro-backups
# Cambiar a 1 únicamente después de aplicar supabase_setup_fix.sql.
FARO_PRIVATE_CLOUD_READY=0
# Alternativa para hosting; en Windows usar configurar_acceso.py.
FARO_USERNAME=admin
FARO_PASSWORD=
# Railway: usar el volumen de uploads existente sin cambiar su punto de montaje.
# FARO_DATA_DIR=/app/backend/uploads/.faro
# FARO_UPLOADS_DIR=/app/backend/uploads
# FARO_REQUIRE_BOOTSTRAP=1
# FARO_BOOTSTRAP_ARCHIVE=nombre-del-respaldo-privado.zip
# FARO_BOOTSTRAP_SHA256=sha256-del-respaldo
