# ============================================================================
# FARO - Variables de Configuración para Supabase
# ============================================================================
# Si completas estos valores, FARO se conectará a tu base de datos en la nube.
# Si los dejas vacíos, FARO continuará funcionando con SQLite local de forma segura.

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-clave-anon-o-service-role-aqui

# Nombre del bucket para almacenar las fotos de prendas en la nube (crear en Supabase Storage como público)
SUPABASE_STORAGE_BUCKET=garment-photos
